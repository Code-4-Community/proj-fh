    {
      "name": "Transition status - approve",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "  pm.test('returns 200', () => pm.response.to.have.status(200));\n  pm.test('describes the transition', () => {\n    const body = pm.response.json();\n    pm.expect(body.transition).to.eql({ from: 'pending_review', to: 'approved_published' });\n    pm.expect(body.resource.review_status).to.eql('approved_published');\n  });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "  { \"status\": \"approved_published\" }",
          "options": {
            "raw": {
