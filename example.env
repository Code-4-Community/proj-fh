# IMPORTANT: NEVER PUT SENSITIVE INFORMATION/SECRETS IN `VITE_` PREFIXED ENV VARIABLES
# All variables prefixed with VITE_ are exposed to client-side code

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=fenway_health_user
POSTGRES_PASSWORD=12345678
POSTGRES_DB=proj_fh


# Swagger UI: set to true only in local and staging — not in production.
SWAGGER_ENABLED=false

# Region
REGION=us-east-2

# Auth content
AUTH_COGNITO_APP_CLIENT_ID=
AUTH_COGNITO_USER_POOL_ID=

# Frontend Cognito configuration (these values are public identifiers)
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_API_BASE_URL=http://localhost:3000