# IMPORTANT: NEVER PUT SENSITIVE INFORMATION/SECRETS IN `VITE_` PREFIXED ENV VARIABLES
# All variables prefixed with VITE_ are exposed to client-side code

# Every variable below is REQUIRED and must be non-empty, or the app fails at
# startup with an error naming the missing ones.
#
# Adding a variable: see "Environment variables" in README.md. In short:
#  - Frontend vars use the VITE_ prefix and go in apps/frontend/src/utils/env.ts.
#  - Everything else has no prefix and goes in apps/backend/src/utils/env.ts.
#  - Add it here with a comment and then tell the team to update their .env.

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=fenway_health_user
POSTGRES_PASSWORD=12345678
POSTGRES_DB=proj_fh


# Swagger UI: set to true only in local and staging — not in production.
SWAGGER_ENABLED=false

# Region
REGION=us-east-2

# Auth content
AUTH_COGNITO_APP_CLIENT_ID=
AUTH_COGNITO_USER_POOL_ID=

# Your personal AWS access key (IAM > Users > you > Security credentials). The
# backend uses it to call the Cognito admin APIs (adding/removing staff).
# Secret: never commit, never share. See "AWS credentials" in README.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend Cognito configuration (these values are public identifiers)
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_API_BASE_URL=http://localhost:3000